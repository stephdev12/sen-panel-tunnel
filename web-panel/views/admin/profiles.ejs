<%- include('../partials/head', { title: 'Profils de Connexion & Tunnels — SEN PANEL TUNNEL' }) %>
<div class="shell">
  <%- include('../partials/sidebar', { role: 'admin' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title">Gestion des Tunnels & Profils Surfeo</h1>
        <p class="page-sub">Configurez les tunnels de connexion et propagez les mises à jour en temps réel à tous vos utilisateurs mobiles Surfeo.</p>
      </div>
      <div class="user-chip">
        <div class="avatar"><%= (username || '?').charAt(0).toUpperCase() %></div>
        <span><%= t('common.connected_as') %> <b><%= username %></b></span>
      </div>
    </div>

    <% if (error) { %><div class="alert error"><i data-lucide="alert-circle"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><i data-lucide="check-circle"></i> <%= success %></div><% } %>

    <!-- Stat Grid -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Tunnels Configurés</span>
          <i data-lucide="layers" class="stat-icon"></i>
        </div>
        <div class="stat-value"><%= profiles.length %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Utilisateurs Surfeo</span>
          <i data-lucide="smartphone" class="stat-icon" style="color:var(--accent);"></i>
        </div>
        <div class="stat-value accent"><%= totalUsers %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Diffusion OTA Client</span>
          <i data-lucide="radio" class="stat-icon" style="color:var(--success);"></i>
        </div>
        <div class="stat-value success" style="font-size:18px;">Automatique</div>
      </div>
    </div>

    <!-- Quick Broadcast Panel -->
    <div class="panel" style="border-color: var(--accent-border); background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 100%);">
      <div class="panel-head" style="border-color: var(--accent-border);">
        <h2 style="color: var(--accent);"><i data-lucide="zap"></i> Mise à jour globale & Diffusion en 1 clic à tous les utilisateurs</h2>
      </div>
      <p style="font-size:13px; color:var(--muted); margin-bottom:16px;">
        Modifiez le point d'accès WebSocket ou l'hôte CDN ici. L'ensemble de vos utilisateurs Surfeo (<%= totalUsers %> appareils) recevront la mise à jour à chaud lors de leur prochaine synchronisation automatique.
      </p>
      <form method="POST" action="/admin/profiles/quick-update-payload">
        <div class="grid-4" style="gap:12px;">
          <div>
            <label for="q_host">Hôte CDN / CloudFront / IP</label>
            <input type="text" id="q_host" name="host" placeholder="d1url4lvz5mor6.cloudfront.net" class="mono" style="background:var(--bg);">
          </div>
          <div>
            <label for="q_port">Port HTTP/WS</label>
            <input type="number" id="q_port" name="port" value="80" class="mono" style="background:var(--bg);">
          </div>
          <div>
            <label for="q_wspath">Chemin WebSocket</label>
            <input type="text" id="q_wspath" name="wspath" value="<%= currentWsPath %>" placeholder="/sen, /tieme, /jean" class="mono" style="background:var(--bg);">
          </div>
          <div>
            <label for="q_sni">SNI SSL (BugHost, optionnel)</label>
            <input type="text" id="q_sni" name="sni" placeholder="domain.com" class="mono" style="background:var(--bg);">
          </div>
        </div>
        <div style="margin-top:14px; display:flex; justify-content:flex-end;">
          <button type="submit" class="btn" style="background:var(--accent); color:#fff; font-weight:600;" onclick="return confirm('Confirmer la mise à jour globale et la diffusion immédiate à tous les utilisateurs Surfeo ?');">
            <i data-lucide="send" style="width:15px; height:15px;"></i> Diffuser à tous les utilisateurs Surfeo
          </button>
        </div>
      </form>
    </div>

    <!-- Profiles List -->
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="layers"></i> Liste des Tunnels (<%= profiles.length %>)</h2>
      </div>
      <% if (profiles.length === 0) { %>
        <div class="empty-state">
          <i data-lucide="layers" style="width:36px; height:36px; opacity:0.3; margin-bottom:8px;"></i>
          <div>Aucun profil de connexion configuré. Créez-en un ci-dessous.</div>
        </div>
      <% } else { %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Nom</th>
              <th>Type</th>
              <th>Version OTA</th>
              <th>Hôte / Serveur</th>
              <th>Port</th>
              <th>Payload / Chemin</th>
              <th>Utilisateurs liés</th>
              <th>Statut</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% profiles.forEach(p => { %>
            <tr>
              <td><b><%= p.name %></b></td>
              <td><span class="pill" style="color:var(--accent);"><%= p.type.toUpperCase() %></span></td>
              <td><span class="pill" style="background:var(--surface-alt); border-color:var(--border);"><b class="mono">v<%= p.version %></b></span></td>
              <td class="mono"><%= p.type === 'ssh' ? (p.parsedParams.host || '-') : (p.parsedParams.server || '-') %></td>
              <td class="mono dim"><%= p.type === 'ssh' ? p.parsedParams.port : p.parsedParams.port %></td>
              <td>
                <% if (p.type === 'ssh') { 
                     let wsMatch = (p.parsedParams.payload || '').match(/GET\s+([^\s]+)/);
                     let wsPathDisplay = wsMatch ? wsMatch[1] : (p.parsedParams.payload ? 'Custom' : '-');
                %>
                  <code class="mono" style="color:var(--accent); font-weight:600;"><%= wsPathDisplay %></code>
                <% } else { %>
                  <code class="mono dim"><%= p.parsedParams.mode || 'UDP' %></code>
                <% } %>
              </td>
              <td>
                <span class="pill" style="color:var(--text); background:var(--surface-alt);">
                  <i data-lucide="users" style="width:12px; height:12px; margin-right:4px;"></i>
                  <%= p.user_count || 0 %> utilisateur(s)
                </span>
              </td>
              <td><span class="pill <%= p.is_active ? 'active' : 'deleted' %>"><%= p.is_active ? 'Actif' : 'Inactif' %></span></td>
              <td class="actions-cell">
                <div class="action-strip">
                  <!-- Edit Profile Button -->
                  <button type="button" class="icon-btn" title="Modifier ce profil de tunnel" data-profile="<%= encodeURIComponent(JSON.stringify(p)) %>" onclick="openEditModal(JSON.parse(decodeURIComponent(this.dataset.profile)))">
                    <i data-lucide="edit-3"></i>
                  </button>

                  <!-- 1-Click Broadcast Button -->
                  <form method="POST" action="/admin/profiles/<%= p.id %>/broadcast" class="inline" onsubmit="return confirm('Diffuser immédiatement le tunnel « <%= p.name %> » à TOUS les utilisateurs Surfeo ?');">
                    <button type="submit" class="icon-btn action-broadcast" title="Diffuser ce tunnel à tous les utilisateurs (1-clic)" style="color:var(--accent);">
                      <i data-lucide="radio"></i>
                    </button>
                  </form>

                  <!-- Delete Profile Button -->
                  <form method="POST" action="/admin/profiles/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Supprimer ce profil ?');">
                    <button type="submit" class="icon-btn action-danger" title="Supprimer">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- Create Profile Form -->
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="plus-circle"></i> Créer un nouveau profil de tunnel</h2>
      </div>
      <form method="POST" action="/admin/profiles/create">
        <div class="grid-2">
          <div>
            <label for="name">Nom du profil (interne)</label>
            <input type="text" id="name" name="name" required placeholder="ex: CloudFront WebSocket Standard">
          </div>
          <div>
            <label for="type">Type de tunnel</label>
            <select id="type" name="type" onchange="toggleProfileType(this.value)">
              <option value="ssh" selected>SSH + WebSocket / HTTP Payload</option>
              <option value="udp">UDP Custom</option>
            </select>
          </div>
        </div>

        <!-- SSH Settings -->
        <div id="sshFields" style="margin-top:16px; border-top:1px solid var(--border); padding-top:14px;">
          <h3 style="font-size:13px; font-weight:600; margin-bottom:12px; color:var(--muted);">PARAMÈTRES SSH</h3>
          <div class="grid-3">
            <div>
              <label for="host">Hôte (CloudFront ou IP)</label>
              <input type="text" id="host" name="host" placeholder="d1url4lvz5mor6.cloudfront.net" class="mono">
            </div>
            <div>
              <label for="port">Port</label>
              <input type="number" id="port" name="port" value="80" class="mono">
            </div>
            <div>
              <label for="udpgwPort">Port UDPGW</label>
              <input type="number" id="udpgwPort" name="udpgwPort" value="7300" class="mono">
            </div>
          </div>

          <div class="grid-2" style="margin-top:14px;">
            <div>
              <label for="ws_path_create">Chemin WebSocket (ex: /sen, /tieme, /jean)</label>
              <input type="text" id="ws_path_create" placeholder="/sen" class="mono" value="<%= currentWsPath %>" oninput="updateCreatePayload(this.value)">
            </div>
            <div>
              <label for="sni">SNI SSL (optionnel)</label>
              <input type="text" id="sni" name="sni" placeholder="domain.com" class="mono">
            </div>
          </div>

          <div style="margin-top:14px;">
            <label for="payload">Payload HTTP (injecté automatiquement dans l'application Surfeo)</label>
            <textarea id="payload" name="payload" rows="2" class="mono">GET <%= currentWsPath %> HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf][crlf]</textarea>
          </div>

          <div class="grid-2" style="margin-top:14px;">
            <div>
              <label for="dns">Serveurs DNS (séparés par virgule)</label>
              <input type="text" id="dns" name="dns" value="1.1.1.1, 8.8.8.8" class="mono">
            </div>
            <div>
              <label for="proxyHost">Proxy HTTP distant (optionnel)</label>
              <input type="text" id="proxyHost" name="proxyHost" placeholder="104.16.0.1:80" class="mono">
            </div>
          </div>
        </div>

        <!-- UDP Custom Settings -->
        <div id="udpFields" style="display:none; margin-top:16px; border-top:1px solid var(--border); padding-top:14px;">
          <h3 style="font-size:13px; font-weight:600; margin-bottom:12px; color:var(--muted);">PARAMÈTRES UDP CUSTOM</h3>
          <div class="grid-3">
            <div>
              <label for="udpServer">Serveur UDP (IP ou domaine)</label>
              <input type="text" id="udpServer" name="udpServer" placeholder="vps.mydomain.com" class="mono">
            </div>
            <div>
              <label for="udpPort">Port UDP</label>
              <input type="number" id="udpPort" name="udpPort" value="36712" class="mono">
            </div>
            <div>
              <label for="udpAuthKey">Clé d'authentification UDP</label>
              <input type="text" id="udpAuthKey" name="udpAuthKey" placeholder="clé secrète" class="mono">
            </div>
          </div>
        </div>

        <div style="margin-top:18px;">
          <button type="submit" class="btn">
            <i data-lucide="check" style="width:14px; height:14px;"></i> Enregistrer le profil
          </button>
        </div>
      </form>
    </div>

  </main>
</div>

<!-- EDIT PROFILE MODAL -->
<div id="editProfileModal" class="custom-modal-backdrop" style="display:none;">
  <div class="custom-modal-dialog">
    <div class="custom-modal-header">
      <h2 style="font-size:16px; font-weight:700; margin:0; display:flex; align-items:center; gap:8px;">
        <i data-lucide="edit-3" style="color:var(--accent);"></i>
        Modifier le profil de tunnel
      </h2>
      <button type="button" class="icon-btn" onclick="closeEditModal()" style="color:var(--muted);">✕</button>
    </div>

    <form id="editProfileForm" method="POST" action="">
      <div class="custom-modal-body">
        <div class="grid-2">
          <div>
            <label for="edit_name">Nom du profil</label>
            <input type="text" id="edit_name" name="name" required class="mono">
          </div>
          <div>
            <label for="edit_is_active">Statut</label>
            <select id="edit_is_active" name="is_active">
              <option value="1">Actif</option>
              <option value="0">Inactif</option>
            </select>
          </div>
        </div>

        <!-- SSH Fields in Modal -->
        <div id="edit_sshFields" style="margin-top:14px;">
          <div class="grid-3">
            <div>
              <label for="edit_host">Hôte (CloudFront / IP)</label>
              <input type="text" id="edit_host" name="host" class="mono">
            </div>
            <div>
              <label for="edit_port">Port</label>
              <input type="number" id="edit_port" name="port" class="mono">
            </div>
            <div>
              <label for="edit_udpgwPort">Port UDPGW</label>
              <input type="number" id="edit_udpgwPort" name="udpgwPort" class="mono">
            </div>
          </div>

          <div class="grid-2" style="margin-top:12px;">
            <div>
              <label for="edit_wspath">Chemin WebSocket</label>
              <input type="text" id="edit_wspath" name="wspath" placeholder="/sen, /tieme, /jean" class="mono" oninput="updateEditPayload(this.value)">
            </div>
            <div>
              <label for="edit_sni">SNI SSL (BugHost)</label>
              <input type="text" id="edit_sni" name="sni" class="mono">
            </div>
          </div>

          <div style="margin-top:12px;">
            <label for="edit_payload">Payload HTTP complet</label>
            <textarea id="edit_payload" name="payload" rows="2" class="mono"></textarea>
          </div>

          <div class="grid-2" style="margin-top:12px;">
            <div>
              <label for="edit_dns">Serveurs DNS</label>
              <input type="text" id="edit_dns" name="dns" class="mono">
            </div>
            <div>
              <label for="edit_proxy_host">Proxy HTTP (optionnel)</label>
              <input type="text" id="edit_proxy_host" name="proxy_host" class="mono">
            </div>
          </div>
        </div>

        <!-- UDP Fields in Modal -->
        <div id="edit_udpFields" style="display:none; margin-top:14px;">
          <div class="grid-3">
            <div>
              <label for="edit_udpServer">Serveur UDP</label>
              <input type="text" id="edit_udpServer" name="udp_server" class="mono">
            </div>
            <div>
              <label for="edit_udpPort">Port UDP</label>
              <input type="number" id="edit_udpPort" name="udp_port" class="mono">
            </div>
            <div>
              <label for="edit_udpAuth">Clé auth UDP</label>
              <input type="text" id="edit_udpAuth" name="resolver" class="mono">
            </div>
          </div>
        </div>

        <!-- BROADCAST TO ALL USERS CHECKBOX -->
        <div style="background:var(--accent-soft); border:1px solid var(--accent-border); padding:12px 14px; border-radius:8px; margin-top:16px;">
          <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer; margin:0;">
            <input type="checkbox" id="edit_apply_to_all" name="apply_to_all" value="1" checked style="width:18px; height:18px; margin-top:2px;">
            <div>
              <span style="font-weight:700; color:var(--accent); font-size:13.5px;">
                🚀 Appliquer et diffuser automatiquement à TOUS les utilisateurs Surfeo (<%= totalUsers %> comptes)
              </span>
              <p style="margin:2px 0 0 0; font-size:12px; color:var(--muted); line-height:1.4;">
                Assigne ce tunnel à tous vos utilisateurs et incrémente la version OTA. Tous les appareils Surfeo connectés téléchargeront la nouvelle configuration automatiquement !
              </p>
            </div>
          </label>
        </div>
      </div>

      <div class="custom-modal-footer">
        <button type="button" class="btn" style="background:var(--surface-alt); color:var(--text); border:1px solid var(--border);" onclick="closeEditModal()">
          Annuler
        </button>
        <button type="submit" class="btn" style="background:var(--accent); color:#fff; font-weight:600;">
          <i data-lucide="check" style="width:14px; height:14px;"></i> Enregistrer & Diffuser
        </button>
      </div>
    </form>
  </div>
</div>

<style>
.custom-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 16px;
}
.custom-modal-dialog {
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 640px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
}
.custom-modal-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.custom-modal-body {
  padding: 20px;
}
.custom-modal-footer {
  padding: 14px 20px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  background: var(--surface-alt);
}
.grid-4 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}
</style>

<script>
function toggleProfileType(val) {
  var sshDiv = document.getElementById('sshFields');
  var udpDiv = document.getElementById('udpFields');
  if (val === 'udp') {
    sshDiv.style.display = 'none';
    udpDiv.style.display = 'block';
  } else {
    sshDiv.style.display = 'block';
    udpDiv.style.display = 'none';
  }
}

function updateCreatePayload(path) {
  var clean = path.trim();
  if (clean && !clean.startsWith('/')) clean = '/' + clean;
  document.getElementById('payload').value = 'GET ' + clean + ' HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf][crlf]';
}

function updateEditPayload(path) {
  var clean = path.trim();
  if (clean && !clean.startsWith('/')) clean = '/' + clean;
  document.getElementById('edit_payload').value = 'GET ' + clean + ' HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf][crlf]';
}

function openEditModal(profile) {
  var modal = document.getElementById('editProfileModal');
  var form = document.getElementById('editProfileForm');
  form.action = '/admin/profiles/' + profile.id + '/edit';

  document.getElementById('edit_name').value = profile.name || '';
  document.getElementById('edit_is_active').value = profile.is_active ? '1' : '0';

  var params = profile.parsedParams || {};

  if (profile.type === 'ssh') {
    document.getElementById('edit_sshFields').style.display = 'block';
    document.getElementById('edit_udpFields').style.display = 'none';

    document.getElementById('edit_host').value = params.host || '';
    document.getElementById('edit_port').value = params.port || 80;
    document.getElementById('edit_udpgwPort').value = params.udpgwPort || 7300;
    document.getElementById('edit_sni').value = params.sni || '';
    document.getElementById('edit_payload').value = params.payload || '';

    // Extract ws path from payload
    var wsMatch = (params.payload || '').match(/GET\s+([^\s]+)/);
    document.getElementById('edit_wspath').value = wsMatch ? wsMatch[1] : '<%= currentWsPath %>';

    document.getElementById('edit_dns').value = Array.isArray(params.dns) ? params.dns.join(', ') : '1.1.1.1, 8.8.8.8';
    document.getElementById('edit_proxy_host').value = (params.proxy && params.proxy.host) ? (params.proxy.host + (params.proxy.port ? ':' + params.proxy.port : '')) : '';
  } else {
    document.getElementById('edit_sshFields').style.display = 'none';
    document.getElementById('edit_udpFields').style.display = 'block';

    document.getElementById('edit_udpServer').value = params.server || '';
    document.getElementById('edit_udpPort').value = params.port || 7300;
    document.getElementById('edit_udpAuth').value = params.resolver || '';
  }

  modal.style.display = 'flex';
  if (window.lucide) window.lucide.createIcons();
}

function closeEditModal() {
  document.getElementById('editProfileModal').style.display = 'none';
}

// Close modal on escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeEditModal();
});
</script>
</body>
</html>
