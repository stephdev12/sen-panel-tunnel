<%- include('../partials/head', { title: 'Comptes App Surfeo — SEN PANEL TUNNEL' }) %>
<div class="shell">
  <%- include('../partials/sidebar', { role: 'admin' }) %>

  <div class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title">Comptes App Surfeo</h1>
        <p class="page-sub">Créez des accès liés par empreinte matérielle (ID appareil) et générez les clés d'activation.</p>
      </div>
      <div class="user-chip">
        <div class="avatar"><%= (username || '?').charAt(0).toUpperCase() %></div>
        <span><%= t('common.connected_as') %> <b><%= username %></b></span>
      </div>
    </div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <% if (createdKey) { %>
    <div class="alert" style="background: rgba(34, 211, 238, 0.15); border: 1px solid var(--accent); color: var(--text); padding: 18px; margin-bottom: 20px;">
      <h3 style="margin-top:0; color:var(--accent);">🔑 Clé d'activation générée (affichée une seule fois)</h3>
      <p style="margin-bottom:8px;">Compte : <b><%= createdKey.username %></b> · ID Appareil : <code class="mono"><%= createdKey.deviceId %></code></p>
      <div style="display:flex; align-items:center; gap:10px; margin: 12px 0;">
        <input type="text" id="copyKeyInput" value="<%= createdKey.key %>" readonly style="font-family:monospace; font-size:16px; font-weight:bold; letter-spacing:1px; flex:1; background:var(--bg); border:1px solid var(--accent); padding:10px;">
        <button class="btn" onclick="navigator.clipboard.writeText('<%= createdKey.key %>'); alert('Clé copiée !');">Copier</button>
      </div>
      <p style="font-size:12px; color:var(--muted); margin-bottom:0;">Message client à envoyer :<br>
        <code>Voici ta clé d'activation Surfeo pour l'appareil <%= createdKey.deviceId %> : <%= createdKey.key %></code>
      </p>
    </div>
    <% } %>

    <div class="panel">
      <div class="panel-head">
        <h2>Comptes liés (<%= accounts.length %>)</h2>
      </div>
      <% if (accounts.length === 0) { %>
        <div class="empty-state">Aucun compte lié à l'application. Créez-en un avec le formulaire ci-dessous.</div>
      <% } else { %>
      <div class="table-scroll">
        <%
        function formatByteCount(b) {
          if (b == null || b <= 0) return '0 B';
          const units = ['B', 'Ko', 'Mo', 'Go', 'To'];
          let idx = 0;
          let val = b;
          while (val >= 1024 && idx < units.length - 1) {
            val /= 1024;
            idx++;
          }
          return (idx === 0 ? Math.round(val) : val.toFixed(val < 10 ? 2 : 1)) + ' ' + units[idx];
        }
        %>
        <table>
          <thead>
            <tr>
              <th>Identifiant</th>
              <th>ID Appareil</th>
              <th>Créé par</th>
              <th>Profil</th>
              <th>Statut</th>
              <th>Consommation / Quota</th>
              <th>Clé (Fin)</th>
              <th>Dernière activité</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% accounts.forEach(a => { %>
            <tr>
              <td><b><%= a.username %></b></td>
              <td><code class="mono"><%= a.device_id %></code></td>
              <td>
                <span class="pill" style="font-size:11px; <%= a.reseller_name ? 'background:rgba(124,92,255,0.15); color:var(--violet);' : 'background:rgba(34,211,238,0.15); color:var(--accent);' %>">
                  <%= a.reseller_name ? a.reseller_name : 'Admin' %>
                </span>
              </td>
              <td><%= a.profile_name || '-' %> (v<%= a.profile_version || '1' %>)</td>
              <td>
                <span class="pill <%= a.state === 'active' ? 'active' : (a.state === 'pending' ? 'locked_manual' : 'locked_expired') %>">
                  <%= a.state %>
                </span>
              </td>
              <td>
                <div style="min-width: 140px;">
                  <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:3px;">
                    <b style="color:var(--text);"><%= formatByteCount(a.usedBytes) %></b>
                    <span style="color:var(--muted);"><%= a.quota_gb ? a.quota_gb + ' Go' : 'Illimité' %></span>
                  </div>
                  <% if (a.quota_gb > 0) { %>
                    <div style="background:var(--bg); border-radius:4px; height:6px; overflow:hidden; border:1px solid rgba(255,255,255,0.08);">
                      <div style="width:<%= Math.min(100, a.percentUsed) %>%; height:100%; background:<%= a.percentUsed >= 95 ? 'var(--danger)' : (a.percentUsed >= 80 ? 'var(--warning)' : 'var(--accent)') %>; border-radius:4px;"></div>
                    </div>
                    <div style="font-size:10px; color:var(--muted); text-align:right; margin-top:2px;"><%= a.percentUsed %>% consommé</div>
                  <% } else { %>
                    <div style="font-size:10px; color:var(--accent); font-weight:500;">Forfait Illimité</div>
                  <% } %>
                </div>
              </td>
              <td class="mono">...<%= a.key_last4 || '----' %></td>
              <td class="mono" style="font-size:12px;"><%= a.last_active_at ? a.last_active_at.replace('T', ' ').slice(0, 19) : 'Jamais' %></td>
              <td>
                <div style="display:flex; gap:6px;">
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/regenerate-key" onsubmit="return confirm('Régénérer une nouvelle clé pour cet appareil ?');">
                    <button type="submit" class="btn small subtle" title="Régénérer la clé">Clé</button>
                  </form>
                  <button type="button" class="btn small subtle" onclick="promptChangeDevice('<%= a.id %>', '<%= a.username %>', '<%= a.device_id %>')">ID</button>
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/revoke" onsubmit="return confirm('Révoquer ce compte ?');">
                    <button type="submit" class="btn small warning">Révoquer</button>
                  </form>
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/delete" onsubmit="return confirm('Supprimer définitivement ce compte ?');">
                    <button type="submit" class="btn small error">Suppr</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- Create App Account Form -->
    <div class="panel">
      <div class="panel-head">
        <h2>Lier un nouvel appareil (Créer un forfait app)</h2>
      </div>
      <form method="POST" action="/admin/app-accounts/create" style="padding:16px;">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
          <div>
            <label for="username">Identifiant SSH</label>
            <input type="text" id="username" name="username" required placeholder="ex: surfeo_user01">
          </div>
          <div>
            <label for="password">Mot de passe SSH (vide = aléatoire fort)</label>
            <input type="password" id="password" name="password" placeholder="Laisser vide pour auto-génération">
          </div>
        </div>

        <div style="margin-top:16px;">
          <label for="device_id">ID de l'appareil (13 caractères au format XXXX-XXXX-XXXX-X)</label>
          <input type="text" id="device_id" name="device_id" required placeholder="ex: 3KJ7-89BM-PQ2R-W" style="font-family:monospace; font-size:15px; font-weight:bold;">
          <small style="color:var(--muted);">Requis. Doit être fourni par l'utilisateur depuis son écran d'accueil Surfeo.</small>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-top:16px;">
          <div>
            <label for="profile_id">Profil de connexion</label>
            <select id="profile_id" name="profile_id" required>
              <% profiles.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> (<%= p.type.toUpperCase() %>)</option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="expiry_date">Date d'expiration (vide = jamais)</label>
            <input type="date" id="expiry_date" name="expiry_date">
          </div>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-top:16px;">
          <div>
            <label for="quota_gb">Quota de données en Go (vide = illimité)</label>
            <input type="number" step="0.1" id="quota_gb" name="quota_gb" placeholder="ex: 50">
          </div>
          <div>
            <label for="max_connections">Limite de sessions simultanées</label>
            <input type="number" id="max_connections" name="max_connections" value="1">
          </div>
        </div>

        <div style="margin-top:20px;">
          <button type="submit" class="btn">Créer le compte et générer la clé</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal / Form for changing device ID -->
<form id="changeDeviceForm" method="POST" style="display:none;">
  <input type="hidden" name="new_device_id" id="changeDeviceInput">
</form>

<script>
function promptChangeDevice(id, username, currentDevice) {
  var newId = prompt('Entrez le nouvel ID appareil pour ' + username + ' (format: XXXX-XXXX-XXXX-X) :', currentDevice);
  if (newId && newId !== currentDevice) {
    var form = document.getElementById('changeDeviceForm');
    form.action = '/admin/app-accounts/' + id + '/change-device-id';
    document.getElementById('changeDeviceInput').value = newId;
    form.submit();
  }
}
</script>
</body>
</html>
