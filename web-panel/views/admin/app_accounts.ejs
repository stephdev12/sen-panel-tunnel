<%- include('../partials/head', { title: 'Comptes App Surfeo — SEN PANEL TUNNEL' }) %>
<div class="shell">
  <%- include('../partials/sidebar', { role: 'admin' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title">Comptes App Surfeo</h1>
        <p class="page-sub">Gestion des accès client, liaisons matérielles et quotas pour l'application mobile Surfeo.</p>
      </div>
      <div class="user-chip">
        <div class="avatar"><%= (username || '?').charAt(0).toUpperCase() %></div>
        <span><%= t('common.connected_as') %> <b><%= username %></b></span>
      </div>
    </div>

    <% if (error) { %><div class="alert error"><i data-lucide="alert-circle"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><i data-lucide="check-circle"></i> <%= success %></div><% } %>

    <% if (createdKey) { %>
    <div class="panel" style="border-color: var(--accent); background: var(--accent-soft);">
      <div class="panel-head" style="border-color: var(--accent-border);">
        <h2 style="color: var(--accent);"><i data-lucide="key"></i> Clé d'activation générée (affichée une seule fois)</h2>
      </div>
      <p style="margin-bottom:8px; font-size:13px;">Compte : <b><%= createdKey.username %></b> · Appareil : <code class="mono"><%= createdKey.deviceId %></code></p>
      <div style="display:flex; align-items:center; gap:8px; margin: 12px 0;">
        <input type="text" id="copyKeyInput" value="<%= createdKey.key %>" readonly class="mono" style="font-size:15px; font-weight:700; letter-spacing:0.05em; background:var(--bg); border-color:var(--accent-border);">
        <button class="btn" style="white-space:nowrap;" data-copy-target="copyKeyInput" data-copied-label="Clé copiée !">
          <i data-lucide="copy" style="width:14px; height:14px;"></i> Copier
        </button>
      </div>
      <p class="dim" style="margin-bottom:0;">Message client : <code>Voici ta clé d'activation Surfeo pour l'appareil <%= createdKey.deviceId %> : <%= createdKey.key %></code></p>
    </div>
    <% } %>

    <%
    function formatByteCount(b) {
      if (b == null || b <= 0) return '0 B';
      const units = ['B', 'Ko', 'Mo', 'Go', 'To'];
      let idx = 0;
      let val = b;
      while (val >= 1024 && idx < units.length - 1) {
        val /= 1024;
        idx++;
      }
      return (idx === 0 ? Math.round(val) : val.toFixed(val < 10 ? 2 : 1)) + ' ' + units[idx];
    }
    const totalBytes = accounts.reduce((sum, a) => sum + (a.usedBytes || 0), 0);
    const activeAccounts = accounts.filter(a => a.state === 'active').length;
    %>

    <!-- 3X-UI Minimal Stat Grid -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Comptes Créés</span>
          <i data-lucide="smartphone" class="stat-icon"></i>
        </div>
        <div class="stat-value"><%= accounts.length %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Comptes Actifs</span>
          <i data-lucide="shield-check" class="stat-icon" style="color:var(--success);"></i>
        </div>
        <div class="stat-value success"><%= activeAccounts %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Consommation Totale</span>
          <i data-lucide="activity" class="stat-icon" style="color:var(--accent);"></i>
        </div>
        <div class="stat-value accent"><%= formatByteCount(totalBytes) %></div>
      </div>
    </div>

    <!-- Accounts List -->
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="users"></i> Comptes Surfeo (<%= accounts.length %>)</h2>
      </div>

      <% if (accounts.length === 0) { %>
        <div class="empty-state">
          <i data-lucide="smartphone" style="width:36px; height:36px; opacity:0.3; margin-bottom:8px;"></i>
          <div>Aucun compte lié à l'application pour le moment.</div>
        </div>
      <% } else { %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Identifiant</th>
              <th>Appareils</th>
              <th>Revendeur</th>
              <th>Profil</th>
              <th>Statut</th>
              <th>Trafic / Quota</th>
              <th>Clé (Fin)</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% accounts.forEach(a => { %>
            <tr>
              <td>
                <div style="font-weight:600;"><%= a.username %></div>
                <div class="dim" style="font-size:11px;">#<%= a.id %></div>
              </td>
              <td>
                <span class="mono" style="font-weight:600; color:var(--text);">
                  <%= a.devices ? a.devices.length : (a.device_id ? 1 : 0) %> / <%= a.max_devices || 2 %>
                </span>
                <% if (a.devices && a.devices.length > 0) { %>
                  <div style="display:flex; flex-wrap:wrap; gap:3px; margin-top:2px;">
                    <% a.devices.forEach(d => { %>
                      <span class="pill" style="font-size:9.5px; padding:0 5px;" title="ID: <%= d.device_id %>">
                        <%= d.device_platform || 'device' %>
                      </span>
                    <% }) %>
                  </div>
                <% } else if (a.device_id) { %>
                  <div class="dim" style="font-size:11px;"><code class="mono"><%= a.device_id.slice(0, 9) %>...</code></div>
                <% } else { %>
                  <div class="dim" style="font-size:11px;">En attente</div>
                <% } %>
              </td>
              <td>
                <span class="pill" style="font-size:11px;">
                  <%= a.reseller_name ? a.reseller_name : 'Admin' %>
                </span>
              </td>
              <td>
                <span class="mono" style="font-size:12px;"><%= a.profile_name || '-' %></span>
              </td>
              <td>
                <span class="pill <%= a.state === 'active' ? 'active' : (a.state === 'pending' ? 'pending' : 'danger') %>">
                  <%= a.state %>
                </span>
              </td>
              <td>
                <div style="min-width: 130px;">
                  <div style="display:flex; justify-content:space-between; font-size:11.5px; margin-bottom:3px;">
                    <span class="mono" style="font-weight:600;"><%= formatByteCount(a.usedBytes) %></span>
                    <span class="dim"><%= a.quota_gb ? a.quota_gb + ' Go' : 'Illimité' %></span>
                  </div>
                  <% if (a.quota_gb > 0) { %>
                    <div class="quota-bar-track">
                      <div class="quota-bar-fill <%= a.percentUsed >= 90 ? 'quota-bar-danger' : (a.percentUsed >= 75 ? 'quota-bar-warning' : '') %>" style="width:<%= Math.min(100, a.percentUsed) %>%;"></div>
                    </div>
                  <% } %>
                </div>
              </td>
              <td class="mono dim">...<%= a.key_last4 || '----' %></td>
              <td class="actions-cell">
                <div class="action-strip">
                  <!-- 1-Click Direct Traffic Reset Button -->
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/reset-traffic" class="inline" onsubmit="return confirm('Remettre le trafic de <%= a.username %> à zéro ?');">
                    <button type="submit" class="icon-btn action-reset" title="Remettre le trafic à zéro (1-clic)">
                      <i data-lucide="rotate-ccw"></i>
                    </button>
                  </form>

                  <!-- Regenerate Key -->
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/regenerate-key" class="inline" onsubmit="return confirm('Régénérer une nouvelle clé pour <%= a.username %> ?');">
                    <button type="submit" class="icon-btn" title="Régénérer la clé d'activation">
                      <i data-lucide="key"></i>
                    </button>
                  </form>

                  <!-- Reset Devices -->
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/reset-devices" class="inline" onsubmit="return confirm('Dissocier tous les appareils de <%= a.username %> ?');">
                    <button type="submit" class="icon-btn" title="Dissocier les appareils liés">
                      <i data-lucide="smartphone-nfc"></i>
                    </button>
                  </form>

                  <!-- Revoke -->
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/revoke" class="inline" onsubmit="return confirm('Révoquer l\'accès pour <%= a.username %> ?');">
                    <button type="submit" class="icon-btn action-warn" title="Révoquer l'accès">
                      <i data-lucide="shield-alert"></i>
                    </button>
                  </form>

                  <!-- Delete -->
                  <form method="POST" action="/admin/app-accounts/<%= a.id %>/delete" class="inline" onsubmit="return confirm('Supprimer définitivement <%= a.username %> ?');">
                    <button type="submit" class="icon-btn action-danger" title="Supprimer définitivement">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- Create App Account Form -->
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="plus-circle"></i> Créer un forfait Surfeo</h2>
      </div>
      <form method="POST" action="/admin/app-accounts/create">
        <div class="grid-2">
          <div>
            <label for="username">Identifiant SSH</label>
            <input type="text" id="username" name="username" required placeholder="ex: surfeo_user01">
          </div>
          <div>
            <label for="password">Mot de passe SSH (vide = automatique)</label>
            <input type="password" id="password" name="password" placeholder="Laisser vide pour auto-génération">
          </div>
        </div>

        <div class="grid-2" style="margin-top:14px;">
          <div>
            <label for="device_id">ID de l'appareil (Optionnel)</label>
            <input type="text" id="device_id" name="device_id" placeholder="Vide = liaison auto à la 1ère activation" class="mono">
            <span class="dim" style="display:block; margin-top:3px;">L'appareil sera lié automatiquement dès la 1ère connexion avec la clé.</span>
          </div>
          <div>
            <label for="max_devices">Nombre max d'appareils</label>
            <input type="number" id="max_devices" name="max_devices" value="2" min="1" max="100" required>
          </div>
        </div>

        <div class="grid-2" style="margin-top:14px;">
          <div>
            <label for="profile_id">Profil de connexion</label>
            <select id="profile_id" name="profile_id" required>
              <% profiles.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> (<%= p.type.toUpperCase() %>)</option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="expiry_date">Date d'expiration (vide = jamais)</label>
            <input type="date" id="expiry_date" name="expiry_date">
          </div>
        </div>

        <div class="grid-2" style="margin-top:14px;">
          <div>
            <label for="quota_gb">Quota de données en Go (vide = illimité)</label>
            <input type="number" step="0.1" id="quota_gb" name="quota_gb" placeholder="ex: 50">
          </div>
          <div>
            <label for="max_connections">Sessions simultanées max</label>
            <input type="number" id="max_connections" name="max_connections" value="2">
          </div>
        </div>

        <div style="margin-top:20px;">
          <button type="submit" class="btn">
            <i data-lucide="check" style="width:15px; height:15px;"></i> Créer le compte et générer la clé
          </button>
        </div>
      </form>
    </div>
  </main>
</div>
</body>
</html>
