<%- include('../partials/head', { title: 'Mes clients — SEN PANEL TUNNEL' }) %>
<div class="shell">
  <%- include('../partials/sidebar', { role: 'reseller' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title"><%= t('nav.my_clients') %></h1>
        <p class="page-sub">
          <span class="pill <%= reseller.status %>">
            <%= reseller.status === 'active' ? t('common.account_active') : (reseller.status === 'locked_manual' ? t('common.account_locked') : t('common.account_expired')) %>
          </span>
        </p>
      </div>
      <div class="user-chip">
        <div class="avatar"><%= (username || '?').charAt(0).toUpperCase() %></div>
        <span><%= t('common.connected_as') %> <b><%= username %></b></span>
      </div>
    </div>

    <% if (error) { %><div class="alert error"><i data-lucide="alert-circle"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><i data-lucide="check-circle"></i> <%= success %></div><% } %>

    <% if (reseller.status !== 'active') { %>
      <div class="alert error">
        <i data-lucide="alert-triangle"></i>
        <span><%= t('reseller_dash.locked_msg') %><%= reseller.status === 'locked_expired' ? t('reseller_dash.locked_msg_expired') : '' %><%= t('reseller_dash.locked_msg_suffix') %></span>
      </div>
    <% } %>

    <!-- 3X-UI Minimal Stat Grid -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label"><%= t('reseller_dash.stat.online_users') %></span>
          <i data-lucide="users" class="stat-icon"></i>
        </div>
        <div class="stat-value"><%= stats.onlineClientCount %> <span class="dim" style="font-size:16px;">/ <%= reseller.max_users %></span></div>
        <div class="quota-text"><span class="quota-text-label">Allouées:</span> <span class="quota-text-value"><%= stats.allocatedConnections %> / <%= reseller.max_users %></span></div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Comptes Surfeo</span>
          <i data-lucide="smartphone" class="stat-icon" style="color:var(--accent);"></i>
        </div>
        <div class="stat-value accent"><%= surfeoAccounts.length %> <span class="dim" style="font-size:16px;">/ <%= reseller.max_surfeo_users != null ? reseller.max_surfeo_users : 5 %></span></div>
        <div class="quota-text"><span class="quota-text-label">Quota:</span> <span class="quota-text-value"><%= reseller.surfeo_quota_gb ? reseller.surfeo_quota_gb + ' Go' : 'Illimité' %></span></div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label"><%= t('reseller_dash.stat.quota_consumed') %></span>
          <i data-lucide="activity" class="stat-icon"></i>
        </div>
        <div class="stat-value">
          <%= fmtData(stats.consumedTotalGb) %>
          <span class="dim" style="font-size:16px;">/ <%= reseller.data_quota_gb != null ? fmtData(reseller.data_quota_gb) : t('common.unlimited') %></span>
        </div>
        <% if (reseller.data_quota_gb != null) { 
             const usedPct = Math.min(100, Math.round((stats.consumedTotalGb / reseller.data_quota_gb) * 100));
             const barLevel = usedPct >= 90 ? 'quota-bar-danger' : (usedPct >= 75 ? 'quota-bar-warning' : '');
             const remainingGb = Math.max(0, reseller.data_quota_gb - stats.consumedTotalGb);
        %>
          <div class="quota-bar-row" style="margin-top:6px;">
            <div class="quota-bar-track">
              <div class="quota-bar-fill <%= barLevel %>" style="width: <%= usedPct %>%;"></div>
            </div>
            <span class="quota-bar-pct <%= barLevel %>"><%= usedPct %>%</span>
          </div>
          <div class="quota-text" style="margin-top:6px; display:flex; justify-content:space-between; align-items:center;">
            <div><span class="quota-text-label">Restant :</span> <span class="quota-text-value" style="font-weight:600;"><%= fmtData(remainingGb) %></span></div>
            <div><span class="quota-text-label">Total :</span> <span class="quota-text-value"><%= fmtData(reseller.data_quota_gb) %></span></div>
          </div>
        <% } %>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label"><%= t('reseller_dash.stat.account_expiry') %></span>
          <i data-lucide="clock" class="stat-icon"></i>
        </div>
        <div class="stat-value mono" style="font-size:16px;"><%= reseller.expiry_date || t('common.never') %></div>
      </div>
    </div>

    <% if (typeof createdKey !== 'undefined' && createdKey) { %>
    <div class="panel" style="border-color: var(--accent); background: var(--accent-soft);">
      <div class="panel-head" style="border-color: var(--accent-border);">
        <h2 style="color:var(--accent);"><i data-lucide="key"></i> Clé d'activation Surfeo générée</h2>
      </div>
      <p style="margin-bottom:8px; font-size:13px;">Compte : <b><%= createdKey.username %></b> · Appareil : <code class="mono"><%= createdKey.deviceId %></code></p>
      <div style="display:flex; align-items:center; gap:8px; margin: 12px 0;">
        <input type="text" id="copyKeyInput" value="<%= createdKey.key %>" readonly class="mono" style="font-size:15px; font-weight:700; background:var(--bg); border-color:var(--accent-border);">
        <button class="btn" data-copy-target="copyKeyInput" data-copied-label="Clé copiée !">
          <i data-lucide="copy" style="width:14px; height:14px;"></i> Copier
        </button>
      </div>
      <p class="dim" style="margin-bottom:0;">Message client : <code>Voici votre clé Surfeo pour l'appareil <%= createdKey.deviceId %> : <%= createdKey.key %></code></p>
    </div>
    <% } %>

    <!-- Section Comptes Surfeo (Mobile App) -->
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="smartphone"></i> Clients Surfeo (<%= surfeoAccounts.length %> / <%= reseller.max_surfeo_users != null ? reseller.max_surfeo_users : 5 %>)</h2>
      </div>

      <%
      function formatByteCount(b) {
        if (b == null || b <= 0) return '0 B';
        const units = ['B', 'Ko', 'Mo', 'Go', 'To'];
        let idx = 0;
        let val = b;
        while (val >= 1024 && idx < units.length - 1) {
          val /= 1024;
          idx++;
        }
        return (idx === 0 ? Math.round(val) : val.toFixed(val < 10 ? 2 : 1)) + ' ' + units[idx];
      }
      %>

      <% if (surfeoAccounts.length === 0) { %>
        <div class="empty-state">
          <i data-lucide="smartphone" style="width:36px; height:36px; opacity:0.3; margin-bottom:8px;"></i>
          <div>Aucun compte client Surfeo créé pour le moment.</div>
        </div>
      <% } else { %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Identifiant</th>
              <th>Appareils</th>
              <th>Profil</th>
              <th>Statut</th>
              <th>Trafic / Quota</th>
              <th>Clé (Fin)</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% surfeoAccounts.forEach(a => { %>
            <tr>
              <td><b><%= a.username %></b></td>
              <td>
                <span class="mono" style="font-weight:600;"><%= a.devices ? a.devices.length : (a.device_id ? 1 : 0) %> / <%= a.max_devices || 2 %></span>
                <% if (a.devices && a.devices.length > 0) { %>
                  <div style="display:flex; flex-wrap:wrap; gap:3px; margin-top:2px;">
                    <% a.devices.forEach(d => { %>
                      <span class="pill" style="font-size:9.5px; padding:0 5px;"><%= d.device_platform || 'device' %></span>
                    <% }) %>
                  </div>
                <% } else if (a.device_id) { %>
                  <div class="dim" style="font-size:10px;"><code class="mono"><%= a.device_id.slice(0, 9) %>...</code></div>
                <% } else { %>
                  <div class="dim" style="font-size:10px;">En attente</div>
                <% } %>
              </td>
              <td><span class="mono" style="font-size:12px;"><%= a.profile_name || '-' %></span></td>
              <td>
                <span class="pill <%= a.state === 'active' ? 'active' : (a.state === 'pending' ? 'pending' : 'danger') %>">
                  <%= a.state %>
                </span>
              </td>
              <td>
                <div style="min-width: 130px;">
                  <div style="display:flex; justify-content:space-between; font-size:11.5px; margin-bottom:3px;">
                    <span class="mono" style="font-weight:600;"><%= formatByteCount(a.usedBytes) %></span>
                    <span class="dim"><%= a.quota_gb ? a.quota_gb + ' Go' : 'Illimité' %></span>
                  </div>
                  <% if (a.quota_gb > 0) { %>
                    <div class="quota-bar-track">
                      <div class="quota-bar-fill <%= a.percentUsed >= 90 ? 'quota-bar-danger' : (a.percentUsed >= 75 ? 'quota-bar-warning' : '') %>" style="width:<%= Math.min(100, a.percentUsed) %>%;"></div>
                    </div>
                  <% } %>
                </div>
              </td>
              <td class="mono dim">...<%= a.key_last4 || '----' %></td>
              <td class="actions-cell">
                <div class="action-strip">
                  <!-- 1-Click Direct Traffic Reset Button -->
                  <form method="POST" action="/reseller/surfeo/<%= a.id %>/reset-traffic" class="inline" onsubmit="return confirm('Remettre le trafic de <%= a.username %> à zéro ?');">
                    <button type="submit" class="icon-btn action-reset" title="Remettre le trafic à zéro (1-clic)">
                      <i data-lucide="rotate-ccw"></i>
                    </button>
                  </form>

                  <form method="POST" action="/reseller/surfeo/<%= a.id %>/regenerate-key" class="inline" onsubmit="return confirm('Générer une nouvelle clé pour <%= a.username %> ?');">
                    <button type="submit" class="icon-btn" title="Régénérer la clé d'activation">
                      <i data-lucide="key"></i>
                    </button>
                  </form>

                  <form method="POST" action="/reseller/app-accounts/<%= a.id %>/reset-devices" class="inline" onsubmit="return confirm('Dissocier tous les appareils liés ?');">
                    <button type="submit" class="icon-btn" title="Dissocier les appareils">
                      <i data-lucide="smartphone-nfc"></i>
                    </button>
                  </form>

                  <form method="POST" action="/reseller/surfeo/<%= a.id %>/delete" class="inline" onsubmit="return confirm('Supprimer ce compte Surfeo ?');">
                    <button type="submit" class="icon-btn action-danger" title="Supprimer définitivement">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- Formulaire Création Compte Surfeo -->
    <% if (surfeoAccounts.length < (reseller.max_surfeo_users != null ? reseller.max_surfeo_users : 5)) { %>
    <div class="panel">
      <div class="panel-head">
        <h2><i data-lucide="plus-circle"></i> Créer une clé client Surfeo</h2>
      </div>
      <form method="POST" action="/reseller/surfeo/create">
        <div class="grid-3">
          <div>
            <label for="username">Identifiant SSH</label>
            <input type="text" id="username" name="username" required placeholder="ex: client01">
          </div>
          <div>
            <label for="device_id">ID Appareil (Optionnel)</label>
            <input type="text" id="device_id" name="device_id" placeholder="Vide = liaison auto" class="mono">
          </div>
          <div>
            <label for="max_devices">Max appareils</label>
            <input type="number" id="max_devices" name="max_devices" value="2" min="1" max="10">
          </div>
        </div>

        <div class="grid-3" style="margin-top:14px;">
          <div>
            <label for="profile_id">Profil de connexion</label>
            <select id="profile_id" name="profile_id" required>
              <% profiles.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> (<%= p.type.toUpperCase() %>)</option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="quota_gb">Quota de données (Go)</label>
            <input type="number" step="0.1" id="quota_gb" name="quota_gb" placeholder="Vide = Illimité" <%= reseller.surfeo_quota_gb ? 'max="' + reseller.surfeo_quota_gb + '"' : '' %>>
          </div>
          <div>
            <label for="expiry_date">Date d'expiration</label>
            <input type="date" id="expiry_date" name="expiry_date">
          </div>
        </div>

        <div style="margin-top:16px;">
          <button type="submit" class="btn">
            <i data-lucide="check" style="width:14px; height:14px;"></i> Générer l'accès Surfeo
          </button>
        </div>
      </form>
    </div>
    <% } %>

    <%- include('../partials/client_manager', {
      createAction: '/reseller/clients',
      clientBase: '/reseller/clients',
      clients,
      allowedProtocols
    }) %>

    <%- include('../partials/deleted_clients', { deletedClients }) %>

    <div class="panel">
      <div class="panel-head"><h2><i data-lucide="lock"></i> <%= t('reseller_dash.account_title') %></h2></div>
      <form method="POST" action="/reseller/change-password">
        <label><%= t('common.new_password') %></label>
        <input type="password" name="new_password" required minlength="6">
        <div style="margin-top:12px;">
          <button class="btn" type="submit"><%= t('common.change_password') %></button>
        </div>
      </form>
    </div>

  </main>
</div>
</body>
</html>
