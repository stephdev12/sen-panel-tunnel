<div class="mobile-topbar">
  <button class="nav-toggle" id="navToggle" aria-label="<%= t('nav.open_menu') %>">
    <i data-lucide="menu" style="width:20px; height:20px;"></i>
  </button>
  <div class="brand" style="font-size:15px;">
    <span class="brand-dot"></span>
    SEN PANEL TUNNEL
  </div>
  <form method="POST" action="/logout" style="margin:0;">
    <button type="submit" class="nav-toggle" aria-label="<%= t('nav.logout') %>" title="<%= t('nav.logout') %>">
      <i data-lucide="log-out" style="width:18px; height:18px;"></i>
    </button>
  </form>
</div>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="sidebar" id="sidebar">
  <div class="brand">
    <span class="brand-dot"></span>
    <span class="brand-text">SEN PANEL</span>
    <span class="version-tag">v<%= typeof version !== 'undefined' ? version : '2.0' %></span>
  </div>

  <% if (role === 'admin') { %>
  <div class="nav-group">
    <div class="nav-label"><%= t('nav.admin_group') %></div>
    <a class="nav-link <%= currentPath === '/admin/system' ? 'active' : '' %>" href="/admin/system">
      <i data-lucide="activity" class="nav-icon"></i>
      <span><%= t('nav.system') %></span>
    </a>
    <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">
      <i data-lucide="users" class="nav-icon"></i>
      <span><%= t('nav.resellers') %></span>
    </a>
    <a class="nav-link <%= currentPath.startsWith('/admin/app-accounts') ? 'active' : '' %>" href="/admin/app-accounts">
      <i data-lucide="smartphone" class="nav-icon"></i>
      <span>Comptes Surfeo</span>
    </a>
    <a class="nav-link <%= currentPath.startsWith('/admin/servers') ? 'active' : '' %>" href="/admin/servers">
      <i data-lucide="server" class="nav-icon"></i>
      <span>Serveurs & Nœuds</span>
    </a>
    <a class="nav-link <%= currentPath.startsWith('/admin/profiles') ? 'active' : '' %>" href="/admin/profiles">
      <i data-lucide="layers" class="nav-icon"></i>
      <span>Profils Tunnel</span>
    </a>
  </div>
  <% } else { %>
  <div class="nav-group">
    <div class="nav-label"><%= t('nav.account_group') %></div>
    <a class="nav-link <%= currentPath === '/reseller' ? 'active' : '' %>" href="/reseller">
      <i data-lucide="users" class="nav-icon"></i>
      <span><%= t('nav.my_clients') %></span>
    </a>
  </div>
  <% } %>

  <div class="nav-group">
    <div class="nav-label"><%= t('nav.info_group') %></div>
    <a class="nav-link <%= currentPath === (role === 'admin' ? '/admin/activity' : '/reseller/activity') ? 'active' : '' %>" href="<%= role === 'admin' ? '/admin/activity' : '/reseller/activity' %>">
      <i data-lucide="history" class="nav-icon"></i>
      <span><%= t('nav.activity') %></span>
    </a>
    <a class="nav-link" href="/about" target="_blank" rel="noopener">
      <i data-lucide="info" class="nav-icon"></i>
      <span><%= t('nav.about') %></span>
    </a>
  </div>

  <div class="nav-group nav-footer">
    <div class="lang-switch">
      <a href="/lang/fr" class="lang-btn <%= lang === 'fr' ? 'active' : '' %>">FR</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
    <form method="POST" action="/logout" style="margin:0;">
      <button class="btn-logout" type="submit">
        <i data-lucide="log-out" class="nav-icon"></i>
        <span><%= t('nav.logout') %></span>
      </button>
    </form>
  </div>
</aside>

<!-- Mobile Bottom Navigation (First-Mobile Design) -->
<nav class="mobile-bottom-bar">
  <% if (role === 'admin') { %>
    <a href="/admin/system" class="bottom-nav-item <%= currentPath === '/admin/system' ? 'active' : '' %>">
      <i data-lucide="activity"></i>
      <span>Système</span>
    </a>
    <a href="/admin" class="bottom-nav-item <%= currentPath === '/admin' ? 'active' : '' %>">
      <i data-lucide="users"></i>
      <span>Revendeurs</span>
    </a>
    <a href="/admin/app-accounts" class="bottom-nav-item <%= currentPath.startsWith('/admin/app-accounts') ? 'active' : '' %>">
      <i data-lucide="smartphone"></i>
      <span>Surfeo</span>
    </a>
    <a href="/admin/servers" class="bottom-nav-item <%= currentPath.startsWith('/admin/servers') ? 'active' : '' %>">
      <i data-lucide="server"></i>
      <span>Serveurs</span>
    </a>
    <button type="button" class="bottom-nav-item" id="mobileMoreBtn">
      <i data-lucide="more-horizontal"></i>
      <span>Plus</span>
    </button>
  <% } else { %>
    <a href="/reseller" class="bottom-nav-item <%= currentPath === '/reseller' ? 'active' : '' %>">
      <i data-lucide="users"></i>
      <span>Mes clients</span>
    </a>
    <a href="/reseller/activity" class="bottom-nav-item <%= currentPath.includes('activity') ? 'active' : '' %>">
      <i data-lucide="history"></i>
      <span>Activité</span>
    </a>
    <button type="button" class="bottom-nav-item" id="mobileMoreBtn">
      <i data-lucide="more-horizontal"></i>
      <span>Menu</span>
    </button>
  <% } %>
</nav>

<script>
  (function () {
    var sidebar = document.getElementById('sidebar');
    var backdrop = document.getElementById('sidebarBackdrop');
    var toggle = document.getElementById('navToggle');
    var moreBtn = document.getElementById('mobileMoreBtn');
    if (!sidebar || !backdrop) return;
    function openMenu() { sidebar.classList.add('open'); backdrop.classList.add('open'); }
    function closeMenu() { sidebar.classList.remove('open'); backdrop.classList.remove('open'); }
    if (toggle) toggle.addEventListener('click', function(e) { e.preventDefault(); sidebar.classList.contains('open') ? closeMenu() : openMenu(); });
    if (moreBtn) moreBtn.addEventListener('click', function(e) { e.preventDefault(); openMenu(); });
    backdrop.addEventListener('click', closeMenu);
  })();
</script>
