<%- include('partials/head', { title: 'Connexion — SEN PANEL TUNNEL' }) %>
<div class="login-shell">
  <div class="login-card">
    <div class="brand">
      <span class="brand-dot"></span>
      <span class="brand-text">SEN PANEL TUNNEL</span>
    </div>
    <p class="login-sub"><%= t('login.subtitle') %></p>

    <div style="display:flex; justify-content:center; gap:8px; margin: -10px 0 20px; font-size: 12px;">
      <a href="/lang/fr" class="dim" style="<%= lang === 'fr' ? 'color:var(--text); font-weight:700;' : '' %>">FR</a>
      <span class="dim">·</span>
      <a href="/lang/en" class="dim" style="<%= lang === 'en' ? 'color:var(--text); font-weight:700;' : '' %>">EN</a>
    </div>

    <% if (error) { %>
      <div class="alert error">
        <i data-lucide="alert-circle"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <div>
        <label for="username"><%= t('login.username') %></label>
        <input type="text" id="username" name="username" required autofocus autocomplete="username">
      </div>

      <div style="margin-top:12px;">
        <label for="password"><%= t('login.password') %></label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>

      <button class="btn" type="submit" style="width:100%; margin-top:20px; height:40px;">
        <i data-lucide="log-in" style="width:15px; height:15px;"></i> <%= t('login.submit') %>
      </button>
    </form>

    <div class="login-footer">
      <span>SEN PANEL TUNNEL v<%= typeof version !== 'undefined' ? version : '2.0' %></span>
      <span> · </span>
      <a href="/about" target="_blank" rel="noopener"><%= t('nav.about') %></a>
    </div>
  </div>
</div>
</body>
</html>
